+  {
+    if ((pte = walk(pagetable, i, 0,1)) == 0)
+      panic("uvmcopy: pte should exist");
+    if ((*pte & PTE_V) == 0 && (*pte & PTE_SWAPPED) == 0)
+      panic("uvmcopy: page not present");
+
+    if (*pte & PTE_SWAPPED)
+    {
+      swapcount++;
+    }
+    else if (*pte & PTE_V)
+    {
+      livecount++;
+    }
+  }
