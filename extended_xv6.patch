+int
+settickets(int ticket)
+{
+  struct proc *p = myproc();
+  acquire(&p->lock);
+  p->tickets_original = ticket;
+  p->tickets_cur = ticket;
+  p->time_slices = 0;
+  release(&p->lock);
+  return 0;
