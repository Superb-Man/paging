+int trapHandler(pagetable_t p, int process_id){
+  //printf("trapHandler-called\n") ;
+  uint64 va = r_stval();
+  if(va >= MAXVA) return 0;
+  pte_t *pte = walk(p,va,0,0);
+  if(pte == 0 || (*pte & PTE_SWAPPED) == 0)
+    return 0;
+  acquireSlock();
+  int vpn = VA2VPN(va);
+  if(*pte & PTE_SWAPPED)
+    swap_in(vpn, process_id, pte);
+  else if((*pte & PTE_V) == 0){
+    releaseSlock();
+    return 0;
+  }
+  releaseSlock();
+  return 1;
